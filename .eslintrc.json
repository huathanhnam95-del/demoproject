{
    "env": {
        "browser": true,
        "es2021": true,
        "module": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "globals": {
        "Logger": "readonly",
        "firebase": "readonly",
        "Sentry": "readonly",
        "LogRocket": "readonly",
        "authFunctions": "writable",
        "firestoreFunctions": "writable",
        "google": "readonly"
    },
    "rules": {
        "no-console": [
            "error",
            {
                "allow": [
                    "warn",
                    "error"
                ]
            }
        ],
        "no-undef": "off",
        "no-unused-vars": "off"
    }
}