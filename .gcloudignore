*
!.gcloudignore
!backend
backend/*
!backend/Dockerfile
!backend/requirements.txt
!backend/cloudbuild.pronunciation.yaml
!backend/local_server
backend/local_server/*
!backend/local_server/__init__.py
!backend/local_server/server.py
!backend/local_server/pronunciation_reference.py
!backend/local_server/pitch_processing.py
# Every module backend/Dockerfile COPYs must be whitelisted here or the build
# context excludes it and the image build fails on a missing path.
!backend/local_server/phoneme_client.py
!backend/local_server/pronunciation_verifier.py
!backend/local_server/models
backend/local_server/models/*
!backend/local_server/models/pronunciation-verifier-v1.json
!public
public/*
!public/cmudict.json

# Phoneme recognizer service files (whitelisted)
!backend/Dockerfile.phoneme
!backend/cloudbuild.phoneme.yaml
!backend/requirements.phoneme-torch.txt
!backend/requirements.phoneme-onnx.txt
!backend/__init__.py
!backend/phoneme_service/
!backend/phoneme_service/*.py
!backend/phoneme_service/model-manifest.json
!backend/phoneme_service/model-manifest.schema.json
