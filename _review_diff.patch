+
+.spc-mode-settings-sheet .status-filter-menu,
+.spc-mode-settings-sheet .length-filter-menu,
+.spc-mode-settings-sheet .difficulty-filter-menu {
+  display: flex !important;
+  position: static !important;
+  flex-wrap: wrap;
+  /* Size each pill to its own content ΓÇö the default `stretch` made every
+     option as tall as the tallest wrapping one. */
+  align-items: flex-start;
+  gap: 8px;
+  width: 100%;
+  min-width: 0;
+  max-height: none;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: none;
+  box-shadow: none;
+  overflow: visible;
+}
+
+.spc-mode-settings-sheet .filter-option {
+  /* The authored option is content-box, which turned a 44px min-height into
+     a 62px pill once padding and border were added. */
+  box-sizing: border-box;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: var(--spc-control-height);
+  margin: 0;
+  padding: 8px 12px;
+  border: 1px solid var(--spc-action-border);
+  border-radius: var(--spc-control-radius);
