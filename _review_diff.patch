+
+/* The dropdown-era selected state was "bold and underlined" text. The pill
+   itself now carries the selection, so drop the underline and inherit the
+   pill colour ΓÇö matching the Read Aloud filters. */
+.spc-mode-settings-sheet .filter-option.selected .filter-option-text {
