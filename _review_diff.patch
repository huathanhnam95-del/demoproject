+            expected_syllables=3,
+        )
+
+    def test_v2_confidence_is_the_aligned_syllable_mean_not_zero(self):
+        response = self._build(self._recognize_v2_result())
+        self.assertNotEqual(response["confidence"], 0.0)
+        self.assertAlmostEqual(
