+/* --------------------------------------------------------------------------
+   Unified segmented filter groups
+   --------------------------------------------------------------------------
+   Speak / Retell Lecture / SGD / Describe Image author their status, length
+   and difficulty filters as `Γû╝` dropdowns. Inside a Speaking settings sheet
+   they render as the same always-visible segmented pills Read Aloud uses, so
+   one mental model covers every Speaking mode. The trigger button and popup
+   positioning are suppressed here; the option nodes, their IDs and their
+   click handlers are untouched. The `!important` flags override the inline
+   `display:none` the owning modules set when the popup is closed. */
+.spc-mode-settings-sheet .status-filter-dropdown,
+.spc-mode-settings-sheet .length-filter-dropdown,
+.spc-mode-settings-sheet .difficulty-filter-dropdown {
+  position: static;
+  width: 100%;
+  margin: 0 0 16px;
+}
+
+.spc-mode-settings-sheet .status-filter-btn,
+.spc-mode-settings-sheet .length-filter-btn,
+.spc-mode-settings-sheet .difficulty-filter-btn {
+  display: none !important;
+}
