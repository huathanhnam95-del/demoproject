+.spc-mode-settings-sheet .filter-option.selected {
+  border-color: #8b5cf6;
+  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
+  color: #6d28d9;
+  box-shadow: 0 2px 6px rgba(124, 58, 237, 0.16);
