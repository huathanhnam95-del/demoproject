        const ariaDisabled = el.getAttribute && String(el.getAttribute('aria-disabled') || '').toLowerCase();
        if (ariaDisabled === 'true') return true;
        const disabledAttr = el.getAttribute && el.getAttribute('disabled');
        if (disabledAttr != null) return true;
        return false;
    }
