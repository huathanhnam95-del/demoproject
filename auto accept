/* eslint-disable no-console */
(function () {
    'use strict';
    const CFG = {
        scanIntervalMs: 250,
        perElementCooldownMs: 2000,
        clickRun: true,
        log: true
    };
    const state = {
        timer: null,
        clicks: 0,
        lastActionAt: 0,
        clickedAtByElement: new WeakMap(),
        ui: null,
        dragging: false,
        drag: { startX: 0, startY: 0, offX: 0, offY: 0 },
        cleanupFns: []
    };
    function t(s) {
        return (s || '').replace(/\s+/g, ' ').trim();
    }
    function rect(el) {
        const r = el.getBoundingClientRect();
        return { x: r.x, y: r.y, w: r.width, h: r.height };
    }
    function isVisible(el) {
        if (!el || el.nodeType !== 1) return false;
        const r = rect(el);
        if (r.w <= 0 || r.h <= 0) return false;
        const style = window.getComputedStyle(el);
        if (!style) return true;
        if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
        return true;
    }
    function isOnScreen(el) {
        const r = rect(el);
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const withinX = r.x < vw && r.x + r.w > 0;
        const withinY = r.y < vh && r.y + r.h > 0;
        return withinX && withinY;
    }
    // Shallow text: only direct text nodes of the element, not nested children.
    // Prevents parent containers from inheriting child button labels.
    function shallowText(el) {
        let txt = '';
        for (const node of el.childNodes) {
            if (node.nodeType === 3) txt += node.textContent;
        }
        return t(txt);
    }
    function labelOf(el) {
        // Prefer shallow text to avoid parent containers grabbing nested labels
        const shallow = shallowText(el);
        const text = shallow || t(el.innerText || el.textContent || '');
        const aria = t(el.getAttribute && el.getAttribute('aria-label'));
        const title = t(el.getAttribute && el.getAttribute('title'));
        return t([text, aria, title].filter(Boolean).join(' '));
    }
    function safeClick(el, reason) {
        const now = Date.now();
        const lastClickedAt = state.clickedAtByElement.get(el) || 0;
        if (!el) return false;
        if (!isVisible(el)) return false;
        if (el.disabled) return false;
        if (now - lastClickedAt < CFG.perElementCooldownMs) return false;
        if (now - state.lastActionAt < 350) return false;
        if (!isOnScreen(el)) return false;  // only click what's visible — never scroll away
        try { el.focus(); } catch (_) { /* intentional ignore */ }
        try {
            el.click();
            state.clickedAtByElement.set(el, now);
            state.clicks += 1;
            state.lastActionAt = now;
            if (CFG.log) console.log('[auto-run] CLICKED:', reason, '| label:', labelOf(el), '| tag:', el.tagName, '| clicks:', state.clicks);
            setStatus(`Clicked: ${reason}`);
            refreshHUD();
            return true;
        } catch (e) {
            setStatus('Click failed');
            return false;
        }
    }
    function scoreRunLabel(labLower) {
        if (!labLower) return -1;
        if (labLower.includes('always run') || labLower === 'reject' || labLower.includes('collapse')) return -1;

        const exact = ['run', 'accept', 'accept all', 'always allow', 'allow this conversation', 'allow', 'retry'];
        if (exact.includes(labLower)) return 100;

        const starts = ['run', 'accept', 'always allow', 'allow', 'retry'];
        if (starts.some(s => labLower.startsWith(s))) return 80;

        const subs = ['always allow', 'accept all', 'retry'];
        if (subs.some(s => labLower.includes(s))) return 60;

        if (labLower === 'expand') return 50;
        if (labLower.includes('expand')) return 40;

        return -1;
    }
    function isInsideApprovalPrompt(el, cache) {
        let container = el.parentElement;
        // Walk up a few levels to find the prompt container
        for (let depth = 0; container && depth < 6; depth++) {
            if (cache.has(container)) return cache.get(container);
            const buttons = container.querySelectorAll('button, [role="button"]');
            // Optimistic abort: typical prompts won't have more than 15 buttons
            if (buttons.length > 15) {
                cache.set(container, false);
                return false;
            }
            for (const btn of buttons) {
                if (btn === el) continue;
                const lab = (shallowText(btn) || t(btn.textContent || '')).toLowerCase();
                if (lab === 'reject' || lab.startsWith('reject') || 
                    lab === 'deny' || lab.startsWith('deny') ||
                    lab === 'cancel') {
                    cache.set(container, true);
                    return true;
                }
            }
            cache.set(container, false);
            container = container.parentElement;
        }
        return false;
    }
    function findBestRunButton() {
        const cache = new Map();
        const candidates = Array.from(document.querySelectorAll('button, [role="button"], a[role="button"]'))
            .filter(el => isVisible(el) && isOnScreen(el));
        let bestRun = null;
        let bestScore = -1;
        let bestY = -1;  // prefer buttons closer to bottom (newer prompts)
        for (const el of candidates) {
            const ll = labelOf(el).toLowerCase();
            const s = scoreRunLabel(ll);
            if (s <= -1) continue;
            // "Expand" buttons don't need approval context (they reveal it)
            const isExpand = ll.includes('expand');
            if (!isExpand && !isInsideApprovalPrompt(el, cache)) {
                if (CFG.log) console.log('[auto-run] SKIP (no Reject sibling):', ll);
                continue;
            }
            if (CFG.log) console.log('[auto-run] candidate:', ll, '→ score:', s, '| y:', Math.round(rect(el).y));
            const elY = rect(el).y;
            if (s > bestScore || (s === bestScore && elY > bestY)) {
                bestScore = s;
                bestRun = el;
                bestY = elY;
            }
        }
        return bestRun;
    }
    function tick() {
        const bestRun = findBestRunButton();
        if (CFG.clickRun && bestRun) {
            const lab = labelOf(bestRun).toLowerCase();
            const reason = lab.includes('expand') ? 'Expand' :
                           lab.includes('retry') ? 'Retry' :
                           lab.includes('accept') ? 'Accept' : 'Run';
            safeClick(bestRun, reason);
        }
        refreshHUD();
    }
    function start() {
        if (state.timer) return;
        setStatus('Running');
        refreshHUD();
        tick();
        state.timer = setInterval(tick, CFG.scanIntervalMs);
    }
    function stop(reason) {
        if (state.timer) clearInterval(state.timer);
        state.timer = null;
        setStatus(`Stopped: ${reason || 'manual'}`);
        refreshHUD();
    }
    function toggle() {
        if (state.timer) stop('manual');
        else start();
    }
    function setStatus(msg) {
        if (!state.ui) return;
        const el = state.ui.querySelector('[data-role="status"]');
        if (el) el.textContent = msg;
    }
    function refreshHUD() {
        if (!state.ui) return;
        const runningEl = state.ui.querySelector('[data-role="running"]');
        const clicksEl = state.ui.querySelector('[data-role="clicks"]');
        const intervalEl = state.ui.querySelector('[data-role="interval"]');
        if (runningEl) runningEl.textContent = state.timer ? 'ON' : 'OFF';
        if (clicksEl) clicksEl.textContent = String(state.clicks);
        if (intervalEl) intervalEl.textContent = String(CFG.scanIntervalMs) + 'ms';
        const btn = state.ui.querySelector('[data-role="toggle"]');
        if (btn) btn.textContent = state.timer ? 'Stop' : 'Start';
    }
    function removeHUD() {
        stop('removed');
        state.dragging = false;
        while (state.cleanupFns.length > 0) {
            const fn = state.cleanupFns.pop();
            try { fn(); } catch (_) { /* intentional ignore */ }
        }
        if (state.ui) {
            const host = document.getElementById('__antigravity_auto_run_host__');
            if (host) host.remove();
        }
        state.ui = null;
    }
    function createHUD() {
        const hostId = '__antigravity_auto_run_host__';
        const oldHost = document.getElementById(hostId);
        if (oldHost) oldHost.remove();

        const host = document.createElement('div');
        host.id = hostId;
        // Position fixed to 0,0 so our inner transforms work, but zero size so it doesn't block clicks
        host.style.cssText = 'position:fixed; z-index:2147483647; top:0; left:0; width:0; height:0; overflow:visible; display:block;';
        document.body.appendChild(host);

        const shadow = host.attachShadow({ mode: 'open' });

        const hud = document.createElement('div');
        hud.id = '__antigravity_auto_run_hud__';
        hud.style.cssText = [
            'position:fixed',
            'top:16px',
            'left:16px',
            'z-index:2147483647',
            'background:rgba(20,20,20,0.92)',
            'color:#e6e6e6',
            'border:1px solid rgba(255,255,255,0.15)',
            'border-radius:10px',
            'box-shadow:0 10px 30px rgba(0,0,0,0.5)',
            'font:12px/1.25 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif',
            'min-width:220px',
            'user-select:none'
        ].join(';');
        const header = document.createElement('div');
        header.style.cssText = [
            'display:flex',
            'align-items:center',
            'justify-content:space-between',
            'padding:10px 10px 8px 10px',
            'cursor:move'
        ].join(';');
        const title = document.createElement('div');
        title.textContent = 'Auto-Run HUD';
        title.style.cssText = 'font-weight:700; letter-spacing:0.2px;';
        const right = document.createElement('div');
        right.style.cssText = 'display:flex; gap:6px; align-items:center;';
        const collapse = document.createElement('button');
        collapse.textContent = '-';
        collapse.style.cssText = [
            'width:26px',
            'height:22px',
            'border-radius:6px',
            'border:1px solid rgba(255,255,255,0.2)',
            'background:rgba(255,255,255,0.08)',
            'color:#e6e6e6',
            'cursor:pointer'
        ].join(';');
        const close = document.createElement('button');
        close.textContent = 'x';
        close.style.cssText = [
            'width:26px',
            'height:22px',
            'border-radius:6px',
            'border:1px solid rgba(255,255,255,0.2)',
            'background:rgba(255,255,255,0.08)',
            'color:#e6e6e6',
            'cursor:pointer'
        ].join(';');
        right.appendChild(collapse);
        right.appendChild(close);
        header.appendChild(title);
        header.appendChild(right);
        const body = document.createElement('div');
        body.style.cssText = 'padding:0 10px 10px 10px; display:block;';
        const row1 = document.createElement('div');
        row1.style.cssText = 'display:flex; gap:10px; align-items:center; margin-bottom:8px;';
        const toggleBtn = document.createElement('button');
        toggleBtn.setAttribute('data-role', 'toggle');
        toggleBtn.textContent = 'Start';
        toggleBtn.style.cssText = [
            'flex:1',
            'height:28px',
            'border-radius:8px',
            'border:1px solid rgba(255,255,255,0.2)',
            'background:rgba(0,122,204,0.85)',
            'color:white',
            'cursor:pointer',
            'font-weight:700'
        ].join(';');
        const hotkey = document.createElement('div');
        hotkey.textContent = 'Ctrl+Alt+R';
        hotkey.style.cssText = 'opacity:0.75; font-size:11px; padding:0 2px;';
        row1.appendChild(toggleBtn);
        row1.appendChild(hotkey);
        const stats = document.createElement('div');
        stats.style.cssText = [
            'display:grid',
            'grid-template-columns: 1fr 1fr',
            'gap:8px',
            'margin-bottom:10px'
        ].join(';');
        function statBox(label, role) {
            const wrap = document.createElement('div');
            wrap.style.cssText = 'padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.06);';
            const k = document.createElement('div');
            k.textContent = label;
            k.style.cssText = 'opacity:0.75; font-size:11px;';
            const v = document.createElement('div');
            v.setAttribute('data-role', role);
            v.textContent = '-';
            v.style.cssText = 'font-weight:800; margin-top:3px;';
            wrap.appendChild(k);
            wrap.appendChild(v);
            return wrap;
        }
        stats.appendChild(statBox('Running', 'running'));
        stats.appendChild(statBox('Clicks', 'clicks'));
        stats.appendChild(statBox('Interval', 'interval'));
        const options = document.createElement('div');
        options.style.cssText = 'display:flex; flex-direction:column; gap:8px; margin-bottom:10px;';
        const optRun = document.createElement('label');
        optRun.style.cssText = 'display:flex; gap:8px; align-items:center; cursor:pointer;';
        const cbRun = document.createElement('input');
        cbRun.type = 'checkbox';
        cbRun.checked = CFG.clickRun;
        cbRun.style.cssText = 'width:14px; height:14px;';
        const txtRun = document.createElement('span');
        txtRun.textContent = 'Click "Run"';
        txtRun.style.cssText = 'opacity:0.9;';
        optRun.appendChild(cbRun);
        optRun.appendChild(txtRun);
        const optInterval = document.createElement('div');
        optInterval.style.cssText = 'display:flex; gap:8px; align-items:center;';
        const intervalLabel = document.createElement('div');
        intervalLabel.textContent = 'Interval';
        intervalLabel.style.cssText = 'opacity:0.75; width:54px; font-size:11px;';
        const intervalInput = document.createElement('input');
        intervalInput.type = 'number';
        intervalInput.min = '50';
        intervalInput.max = '5000';
        intervalInput.step = '50';
        intervalInput.value = String(CFG.scanIntervalMs);
        intervalInput.style.cssText = [
            'flex:1',
            'height:24px',
            'border-radius:6px',
            'border:1px solid rgba(255,255,255,0.2)',
            'background:rgba(0,0,0,0.2)',
            'color:#e6e6e6',
            'padding:0 8px'
        ].join(';');
        optInterval.appendChild(intervalLabel);
        optInterval.appendChild(intervalInput);
        options.appendChild(optRun);
        options.appendChild(optInterval);
        const status = document.createElement('div');
        status.setAttribute('data-role', 'status');
        status.textContent = 'Idle';
        status.style.cssText = 'opacity:0.85; font-size:11px; padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.04);';
        body.appendChild(row1);
        body.appendChild(stats);
        body.appendChild(options);
        body.appendChild(status);
        hud.appendChild(header);
        hud.appendChild(body);
        shadow.appendChild(hud);
        function bind(target, event, handler, options) {
            target.addEventListener(event, handler, options);
            state.cleanupFns.push(() => target.removeEventListener(event, handler, options));
        }
        bind(toggleBtn, 'click', () => toggle());
        bind(cbRun, 'change', () => {
            CFG.clickRun = !!cbRun.checked;
            refreshHUD();
        });
        bind(intervalInput, 'change', () => {
            const v = Number(intervalInput.value);
            if (Number.isFinite(v) && v >= 50 && v <= 5000) {
                CFG.scanIntervalMs = v;
                if (state.timer) {
                    stop('interval changed');
                    start();
                }
            } else {
                intervalInput.value = String(CFG.scanIntervalMs);
            }
            refreshHUD();
        });
        let collapsed = false;
        bind(collapse, 'click', () => {
            collapsed = !collapsed;
            body.style.display = collapsed ? 'none' : 'block';
            collapse.textContent = collapsed ? '+' : '-';
        });
        function keyHandler(e) {
            if (e.ctrlKey && e.altKey && (e.key === 'r' || e.key === 'R')) {
                e.preventDefault();
                toggle();
            }
        }
        function cleanupAll() {
            removeHUD();
            delete window.__antigravityAutoRunStop;
            delete window.__antigravityAutoRunToggle;
            delete window.__antigravityAutoRunHUD;
            delete window.__antigravityAutoRunRemoveHUD;
        }
        bind(close, 'click', cleanupAll);
        function onMouseDown(e) {
            if (e.target.closest && e.target.closest('button, input')) return;
            state.dragging = true;
            state.drag.startX = e.clientX;
            state.drag.startY = e.clientY;
            const m = (hud.style.transform || '').match(/translate3d\(([-0-9.]+)px,\s*([-0-9.]+)px/);
            state.drag.offX = m ? Number(m[1]) : 0;
            state.drag.offY = m ? Number(m[2]) : 0;
            e.preventDefault();
        }
        function onMouseMove(e) {
            if (!state.dragging) return;
            const dx = e.clientX - state.drag.startX;
            const dy = e.clientY - state.drag.startY;
            const x = state.drag.offX + dx;
            const y = state.drag.offY + dy;
            hud.style.transform = `translate3d(${x}px, ${y}px, 0px)`;
            e.preventDefault();
        }
        function onMouseUp() {
            state.dragging = false;
        }
        bind(header, 'mousedown', onMouseDown);
        // Bind to shadow and window root for dragging across the page
        bind(window, 'mousemove', onMouseMove);
        bind(window, 'mouseup', onMouseUp);
        bind(document, 'keydown', keyHandler, true);
        return hud;
    }
    if (window.__antigravityAutoRunRemoveHUD) {
        try { window.__antigravityAutoRunRemoveHUD(); } catch (_) { /* intentional ignore */ }
    }
    state.ui = createHUD();
    refreshHUD();
    window.__antigravityAutoRunStop = stop;
    window.__antigravityAutoRunToggle = toggle;
    window.__antigravityAutoRunHUD = state.ui;
    window.__antigravityAutoRunRemoveHUD = removeHUD;
    setStatus('Ready');
})();
