(function () {
    'use strict';
    const CFG = {
        scanIntervalMs: 250,
        perElementCooldownMs: 2000,
        clickRun: true,
        log: true,
        allowDangerous: false, // "Always allow", "Accept all"
        skipCookiePrompts: true,
        requireTopmost: false
    };
    const state = {
        timer: null,
        clicks: 0,
        lastActionAt: 0,
        lastExpandClickAt: 0,
        burstCount: 0,
        burstStartAt: 0,
        clickedAtByElement: new WeakMap(),
        ui: null,
        uiEls: null,
        dragging: false,
        drag: { startX: 0, startY: 0, offX: 0, offY: 0 },
