        const buttonSelector = 'button, [role="button"], a[role="button"], [class*="button" i], [class*="btn" i]';
        const allButtons = queryAllDeep(buttonSelector);

        // Priority 1: Expand a "Requires Input" panel
        if (CFG.clickRun && (now - state.lastExpandClickAt > 5000)) {
            for (const el of allButtons) {
                const ll = labelOf(el).toLowerCase();
                if (!ll.includes('expand')) continue;
                if (!isOnScreen(el) || !isVisible(el)) continue;

                let parent = el.parentElement || (el.getRootNode && el.getRootNode().host);
                for (let depth = 0; parent && depth < 5; depth++) {
                    const parentText = t(parent.textContent || '').toLowerCase();
                    if (parentText.includes('requires input')) {
                        state.lastExpandClickAt = now;
                        safeClick(el, 'Expand (Requires Input)');
                        return;
                    }
                    parent = parent.parentElement || (parent.getRootNode && parent.getRootNode().host);
                }
            }
        }

        // Priority 2: Click best Run/Accept button
        let bestRun = null;
        let bestScore = -1;
        let bestY = -1;
        for (const el of allButtons) {
            const ll = labelOf(el).toLowerCase();
            const s = scoreRunLabel(ll);
            if (s <= -1) continue;
            if (!isOnScreen(el) || !isVisible(el)) continue;

            if (!isInsideApprovalPrompt(el, cache)) continue;

            const elY = rect(el).y;
            if (s > bestScore || (s === bestScore && elY > bestY)) {
                bestScore = s;
                bestRun = el;
                bestY = elY;
            }
        }

        if (CFG.clickRun && bestRun) {
            const lab = labelOf(bestRun).toLowerCase();
            const reason = lab.includes('retry') ? 'Retry' : lab.includes('accept') ? 'Accept' : 'Run';
            safeClick(bestRun, reason);
        }
        refreshHUD();
    }
    function start() {
        if (state.timer) return;
        setStatus('Running');
        refreshHUD();
        tick();
        state.timer = setInterval(tick, CFG.scanIntervalMs);
    }
    function stop(reason) {
        if (state.timer) clearInterval(state.timer);
        state.timer = null;
        setStatus(`Stopped: ${reason || 'manual'}`);
        refreshHUD();
    }
    function toggle() {
        if (state.timer) stop('manual');
        else start();
    }
    function setStatus(msg) {
        if (state.uiEls && state.uiEls.status) {
            state.uiEls.status.textContent = msg;
            return;
        }
        if (!state.ui) return;
        const el = state.ui.querySelector('[data-role="status"]');
        if (el) el.textContent = msg;
    }
    function refreshHUD() {
        if (!state.ui) return;
        const runningEl = (state.uiEls && state.uiEls.running) ? state.uiEls.running : state.ui.querySelector('[data-role="running"]');
        const clicksEl = (state.uiEls && state.uiEls.clicks) ? state.uiEls.clicks : state.ui.querySelector('[data-role="clicks"]');
        const intervalEl = (state.uiEls && state.uiEls.interval) ? state.uiEls.interval : state.ui.querySelector('[data-role="interval"]');
        if (runningEl) runningEl.textContent = state.timer ? 'ON' : 'OFF';
        if (clicksEl) clicksEl.textContent = String(state.clicks);
        if (intervalEl) intervalEl.textContent = String(CFG.scanIntervalMs) + 'ms';
        const btn = (state.uiEls && state.uiEls.toggle) ? state.uiEls.toggle : state.ui.querySelector('[data-role="toggle"]');
