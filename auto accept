        if (!isElement(el)) return false;
        const r = rect(el);
        const cx = Math.max(0, Math.min(window.innerWidth - 1, r.x + r.w / 2));
        const cy = Math.max(0, Math.min(window.innerHeight - 1, r.y + r.h / 2));

        // Penetrate shadow DOM for topmost check
        const elements = document.elementsFromPoint(cx, cy);
        if (!elements || elements.length === 0) return false;
        const top = elements[0];
        return top === el || el.contains(top) || (top.shadowRoot && top.shadowRoot.contains(el));
    }
    function queryAllDeep(selector, root = document) {
