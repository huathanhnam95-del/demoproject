    function scoreRunLabel(labLower) {
        if (!labLower) return -1;
        if (labLower.includes('always run') || labLower.includes('reject') || labLower.includes('cancel') || labLower.includes('collapse') || labLower.includes('expand')) return -1;

        const exactSafe = ['run', 'accept', 'allow this conversation', 'allow', 'retry', 'approve', 'yes', 'confirm'];
        const exactDanger = ['accept all', 'always allow'];
        const exact = CFG.allowDangerous ? exactSafe.concat(exactDanger) : exactSafe;
        if (exact.includes(labLower)) return 100;

        const startsSafe = ['run', 'accept', 'allow', 'retry', 'approve', 'yes', 'confirm'];
        const startsDanger = ['always allow'];
        const starts = CFG.allowDangerous ? startsSafe.concat(startsDanger) : startsSafe;
        if (starts.some(s => labLower.startsWith(s))) return 80;

        const subsSafe = ['retry', 'run command', 'approve'];
        const subsDanger = ['always allow', 'accept all'];
        const subs = CFG.allowDangerous ? subsSafe.concat(subsDanger) : subsSafe;
        if (subs.some(s => labLower.includes(s))) return 60;

        return -1;
