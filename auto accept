    function looksLikeCookiePrompt(container) {
        if (!CFG.skipCookiePrompts) return false;
        if (!isElement(container)) return false;
        const txt = t(container.textContent || '').toLowerCase();
        if (!txt) return false;
        return txt.includes('cookie') || txt.includes('cookies') || (txt.includes('privacy') && txt.includes('consent'));
    }
    function isInsideApprovalPrompt(el, cache) {
        let container = el.parentElement;
        const visited = [];
        // Walk up a few levels to find the prompt container
        for (let depth = 0; container && depth < 20; depth++) {
            if (cache.has(container)) {
                const res = cache.get(container);
                for (const v of visited) cache.set(v, res);
                return res;
            }
            visited.push(container);
            if (looksLikeCookiePrompt(container)) {
                for (const v of visited) cache.set(v, false);
                return false;
            }
            const buttons = container.querySelectorAll('button, [role="button"], [class*="button" i], [class*="btn" i]');
            // Optimistic abort: typical prompts won't have more than 80 buttons
            if (buttons.length > 80) {
                for (const v of visited) cache.set(v, false);
                return false;
            }
            for (const btn of buttons) {
                if (btn === el) continue;
                const lab = labelOf(btn).toLowerCase();
                if (lab === 'reject' || lab.startsWith('reject') ||
                    lab === 'deny' || lab.startsWith('deny') ||
                    lab === 'cancel' || lab.includes("don't allow") || lab.includes('decline') ||
                    lab === 'not now' || lab === 'later' || lab === 'no') {
                    for (const v of visited) cache.set(v, true);
                    return true;
                }
            }
            container = container.parentElement;
        }
        for (const v of visited) cache.set(v, false);
        return false;
    }
    function tick() {
        const now = Date.now();
        const cache = new Map();

