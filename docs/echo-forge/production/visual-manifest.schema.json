{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bel.local/echo-forge/production/visual-manifest.schema.json",
  "title": "Echo Forge deterministic visual manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractId", "schemaVersion", "manifestStage", "sourceSha256", "assetIds", "assets", "tool", "provenance", "motion"],
  "properties": {
    "$schema": { "const": "./visual-manifest.schema.json" },
    "contractId": { "const": "echo-forge-visual-v1" },
    "schemaVersion": { "const": "echo-forge-visual-manifest-v1" },
    "manifestStage": { "const": "production-ready" },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assetIds": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "assets": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/asset" } },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "revision"], "properties": { "name": { "type": "string" }, "revision": { "type": "string" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["kind", "provider", "review"], "properties": { "kind": { "const": "project-authored-deterministic-vector" }, "provider": { "type": "string" }, "review": { "type": "string" } } },
    "motion": { "type": "object", "additionalProperties": false, "required": ["windUpMs", "analysisHoldFrameCount", "analysisHoldCycleMs", "resultEnterMs", "resultHoldMs", "resultReturnMs", "reducedMotion"], "properties": { "windUpMs": { "const": 200 }, "analysisHoldFrameCount": { "const": 4 }, "analysisHoldCycleMs": { "const": 600 }, "resultEnterMs": { "const": 100 }, "resultHoldMs": { "const": 1000 }, "resultReturnMs": { "const": 400 }, "reducedMotion": { "const": "static-equivalent" } } }
  },
  "$defs": {
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "canvas", "frames", "pivot", "mobileSafeCrop", "staticFallbackFrame", "loop", "timingVariable"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "canvas": { "$ref": "#/$defs/size" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } },
        "pivot": { "$ref": "#/$defs/point" }, "mobileSafeCrop": { "$ref": "#/$defs/size" },
        "staticFallbackFrame": { "type": "integer", "minimum": 0 }, "loop": { "type": "boolean" }, "timingVariable": { "type": "string" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frameIndex", "name", "path", "sha256", "width", "height", "alpha"],
      "properties": { "frameIndex": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }, "path": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.png$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "alpha": { "const": true } }
    },
    "size": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } }
  }
}
