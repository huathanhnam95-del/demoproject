{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "runtime": "nodejs20",
            "predeploy": [
                "node scripts/read-aloud/build-connected-speech-index.js"
            ]
        }
    ],
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "firestore": {
            "port": 8080,
            "host": "localhost"
        },
        "auth": {
            "port": 9099,
            "host": "localhost"
        },
        "functions": {
            "port": 5001,
            "host": "localhost"
        },
        "storage": {
            "port": 9199,
            "host": "localhost"
        },
        "ui": {
            "enabled": true,
            "port": 4000,
            "host": "localhost"
        }
    },
    "hosting": {
        "public": "public",
        "predeploy": [
            "node scripts/read-aloud/build-connected-speech-index.js"
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": {
                    "functionId": "api",
                    "region": "us-central1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
