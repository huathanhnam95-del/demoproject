rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin via internal flag
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own user profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Prevent users from setting themselves as admin
      allow write: if isOwner(userId) && 
                   !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
      
      // Users can read/write their own progress data (tiered progression)
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }
      
      // SRS System Cards - allow owner full access
      match /srs_cards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      // Users can create and read their own points history
      match /pointsHistory/{historyId} {
        allow read, create: if isOwner(userId);
      }

      // Vocabulary Book data
      match /vocabularyBook/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // Watch mode progress per video
      match /watchProgress/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // Purchase history
      match /purchases/{purchaseId} {
        allow read, create: if isOwner(userId);
      }
    }
    
    // Users can create practice attempts (read their own)
    match /practiceAttempts/{attemptId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Users can read/write their own sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Points rules - any logged-in user can read
    // Write access is via Admin SDK only (sync-points-rules.js script)
    match /pointsRules/{ruleId} {
      allow read: if request.auth != null;
    }
    
    // Watch mode video questions
    // Anyone can read (including guests), only admin can write
    match /watchVideos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // Take Notes entries
    // Anyone can read (including guests), only admin can write
    match /takeNotesEntries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Word References for Pronunciation Analyzer
    // Anyone can read (cached dictionary data), authenticated users can write
    match /word_references/{wordId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
