rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin via internal flag
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Create: Prevent users from setting themselves as admin or teacher roles,
      // and prevent fabrication of scoring, points, coins, ratings or progression flags.
      allow create: if isOwner(userId) && 
                    (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false) &&
                    !request.resource.data.keys().hasAny([
                      'role', 'crmRole', 'isTeacher', 'admin',
                      'totalPoints', 'coins', 'skillPoints', 'skillRatings',
                      'cefrLevels', 'skillsUpdatedAt',
                      'vocabularyBookUnlocked', 'sentenceLengthFilterUnlocked'
                    ]) &&
                    request.resource.data.keys().hasOnly([
                      'email',
                      'displayName',
                      'photoURL',
                      'createdAt',
                      'lastLoginAt',
                      'totalActiveSeconds',
                      'englishLevel',
                      'levelSelectedAt',
                      'practiceStats',
                      'srsBonus',
                      'unlockedModes',
                      'isAdmin'
                    ]) &&
                    (!('unlockedModes' in request.resource.data) ||
                     request.resource.data.unlockedModes.hasOnly(['type', 'speak', 'extended', 'watch', 'notes', 'pronounce']));
      
      // Update: CLIENT CAN ONLY UPDATE HARMLESS PROFILE FIELDS
      // Scoring and currency fields are SERVER-ONLY (Cloud Functions)
      allow update: if isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'admin', 'role', 'crmRole', 'isTeacher']) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      // Allowed client-writable fields:
                      'lastLoginAt', 
                      'totalActiveSeconds',
                      'englishLevel', 
                      'levelSelectedAt',
                      'practiceStats',
                      'srsBonus'
                      // REMOVED: unlockedModes, totalPoints, coins, skillPoints, skillRatings, 
                      // cefrLevels, skillsUpdatedAt,
                      // vocabularyBookUnlocked, sentenceLengthFilterUnlocked
                    ]);
      
      // Progress data (tiered progression) - client can still manage
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }
      
      // SRS System Cards - client can manage review scheduling
      match /srs_cards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      // Points History - SERVER-ONLY (Cloud Functions write only)
      match /pointsHistory/{historyId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;  // Client cannot write
      }

      // Writing Challenge history (user-authored content + AI feedback)
      match /writingHistory/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Vocabulary Book data - client can manage word lists
      match /vocabularyBook/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // Watch mode progress per video - client tracks local state
      match /watchProgress/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // Take Notes progress - client tracks local state
      match /takeNotesProgress/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Purchase history - SERVER-ONLY (Cloud Functions write only)
      match /purchases/{purchaseId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;  // Client cannot write
      }
    }
    
    // ============================================
    // PRACTICE ATTEMPTS (tightened schema)
    // ============================================
    match /practiceAttempts/{attemptId} {
      // Tightened: require userId match and valid mode
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.mode in ['type', 'speak', 'extended', 'watch', 'notes', 'writingChallenge', 'srs'];
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // SESSIONS (client-managed for analytics)
    // ============================================
    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }
    
    // ============================================
    // POINTS RULES (read-only reference data)
    // ============================================
    match /pointsRules/{ruleId} {
      allow read: if request.auth != null;
    }
    
    // ============================================
    // CONTENT ITEMS (canonical content for server-side scoring)
    // Read-only for clients, write via Admin SDK only
    // ============================================
    match /contentItems/{contentId} {
      allow read: if true;  // Anyone can read content for display
      allow write: if false;  // Admin SDK only (migration script)
    }
    
    // ============================================
    // CONTENT COLLECTIONS (admin-managed)
    // ============================================
    match /watchVideos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Public question metadata
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Private answer keys (Server/Admin ONLY)
      match /questionKeys/{questionId} {
        allow read, write: if isAdmin(); 
      }
    }
    
    match /takeNotesEntries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Word References for Pronunciation Analyzer (canonical reference data)
    match /word_references/{wordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CRM STUDENTS (Identity Merging)
    // ============================================
    match /crmStudents/{studentId} {
      // Allow read if user is admin OR if their uid is in the linked_user_ids array
      allow read: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.linked_user_ids);
      allow write: if isAdmin();
    }

    // ============================================
    // COURSES
    // ============================================
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================
    // CLASSROOM FEATURE
    // ============================================
    match /crmClassrooms/{classId} {
      function isClassroomMember() {
        return request.auth != null && (
          exists(/databases/$(database)/documents/crmClassrooms/$(classId)/members/$(request.auth.uid))
        );
      }

      function isAssignedTeacher(classData) {
        return request.auth != null && (
          classData.get('primaryTeacherUid', '') == request.auth.uid ||
          classData.get('teacherUid', '') == request.auth.uid ||
          (classData.get('teacherUids', []) is list && request.auth.uid in classData.get('teacherUids', []))
        );
      }

      function canReadClassroom() {
        return isAdmin() || isClassroomMember() || isAssignedTeacher(resource.data);
      }

      function canReadClassroomSubcollection() {
        return isAdmin() || isClassroomMember() || (
          request.auth != null
          && exists(/databases/$(database)/documents/crmClassrooms/$(classId))
          && isAssignedTeacher(get(/databases/$(database)/documents/crmClassrooms/$(classId)).data)
        );
      }

      allow read: if canReadClassroom();
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if canReadClassroomSubcollection();
        allow write: if isAdmin();
      }

      match /classwork/{workId} {
        allow read: if canReadClassroomSubcollection();
        allow write: if isAdmin();
      }

      match /posts/{postId} {
        allow read: if canReadClassroomSubcollection();
        allow write: if isAdmin();
      }

      match /members/{memberId} {
        allow read: if canReadClassroomSubcollection();
        allow write: if isAdmin();
      }
    }

    // ============================================
    // SUBMISSIONS (SERVER-AUTHORITATIVE)
    // ============================================
    match /crmSubmissions/{submissionId} {
      // Submissions are created and modified exclusively via Cloud Functions backend (/api/student/classrooms/.../submissions).
      // Admin SDK writes bypass rules; no browser client may mutate this collection.
      allow create, update, delete: if false;

      // Student owner or admin can read submissions (teachers access submissions via Admin SDK endpoint)
      allow read: if isAdmin() || (
        request.auth != null && resource.data.studentUid == request.auth.uid
      );
    }

    // Short-lived upload capabilities are created and consumed by the backend.
    match /crmSubmissionUploadSlots/{uploadIntentId} {
      allow read, write: if false;
    }

    // ============================================
    // SERVER-OWNED SPEAKING ATTEMPT DATA
    // ============================================
    // These collections are mutated by Cloud Functions only.
    match /speakingAttempts/{attemptId} {
      allow read, write: if false;

      match /feedback/{feedbackId} {
        allow read, write: if false;
      }
    }

    match /speakingAttemptShares/{shareId} {
      allow read, write: if false;
    }

    match /speakingAttemptCounters/{uid} {
      allow read, write: if false;
    }

    match /speakingAttemptEvents/{eventId} {
      allow read, write: if false;
    }

    match /practiceAccessByUid/{uid} {
      allow read, write: if false;
    }

    match /practiceAccessJobs/{jobId} {
      allow read, write: if false;
    }

    // ============================================
    // DEEP AI ESSAY REVIEW (server-created queue)
    // ============================================
    match /essay_ai_queue/{queueId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, delete: if false; // Cloud Functions Admin SDK bypasses rules.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.isRead is bool
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /essay_ai_usage/{uid} {
      allow read, write: if false;
    }

    match /user_notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, delete: if false;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.isRead is bool
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /crm_system_alerts/{alertId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
                    && resource.data.status == 'unresolved'
                    && request.resource.data.status == 'resolved'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /essay_ai_backfill_jobs/{jobId} {
      allow read, write: if false;
    }

    match /essay_ai_backfill_control/{controlId} {
      allow read, write: if false;
    }

    match /essay_ai_worker_status/{statusId} {
      allow read, write: if false;
    }

    // ============================================
    // VOICE CLONING (server & worker-owned; Admin SDK bypasses rules)
    // ============================================
    match /voice_profiles/{profileId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /voice_cloning_queue/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /voice_cloning_control/{controlId} {
      allow read, write: if false;
    }

    match /voice_worker_status/{statusId} {
      allow read, write: if false;
    }

    // ============================================
    // CRM BOOKS (server-owned; Admin SDK bypasses rules)
    // ============================================
    match /crmBooks/{bookId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{document=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /crmBookIngestJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Generated pronunciation reference assets are created and transitioned
    // only by authenticated server routes. Admins may inspect queue metadata.
    match /pronunciationReferenceAudio/{referenceAudioKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ENTRANCE TEST UI REVIEW (internal design vote)
    // ============================================
    // Staff evaluate the three candidate entrance-test skins from the CRM.
    // They share one CRM login, so the rater is the name they type, not the
    // uid — which is why any signed-in admin may write any rater's document.
    // Nothing here touches student data or scoring; it is design feedback.
    match /entranceTestUiRatings/{raterId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(
                                 ['name', 'ratings', 'fonts', 'createdAt', 'updatedAt'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }

    // CRM Projects privileges, automation records and attachments are
    // server-owned. The authenticated API rechecks membership per request.
    match /crmWorkforceAccounts/{uid} { allow read, write: if false; }
    match /crmProjectMembers/{memberId} { allow read, write: if false; }
    match /crmProjectOrganizationConfig/{configId} { allow read, write: if false; }
    match /crmProjectAllowanceConfigs/{configId} { allow read, write: if false; }
    match /crmProjectAllowanceDefaults/{configId} { allow read, write: if false; }
    match /crmProjectAccessAudit/{entryId} { allow read, write: if false; }
    match /crmProjects/{projectId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /crmProjectOperations/{operationId} { allow read, write: if false; }
    match /crmProjectEvents/{eventId} { allow read, write: if false; }
    match /crmProjectAutomationRules/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationVersions/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationRegistries/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationPreviews/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationRuns/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationJournals/{recordId} { allow read, write: if false; }
    match /crmProjectDueOccurrences/{recordId} { allow read, write: if false; }
    match /crmProjectDueIndex/{recordId} { allow read, write: if false; }
    match /crmProjectDueRebuilds/{recordId} { allow read, write: if false; }
    match /crmProjectNotifications/{recordId} { allow read, write: if false; }
    match /crmProjectNotificationPreferences/{recordId} { allow read, write: if false; }
    match /crmProjectNotificationDeliveries/{recordId} { allow read, write: if false; }
    match /crmProjectAutomationWorkers/{recordId} { allow read, write: if false; }
    match /crmProjectCursors/{cursorId} { allow read, write: if false; }

    // Shared AI accounting and voice records are server-only.
    match /crmAiBudgetAccounts/{recordId} { allow read, write: if false; }
    match /crmAiBudgetLedgers/{recordId} { allow read, write: if false; }
    match /crmAiBudgetReservations/{recordId} { allow read, write: if false; }
    match /crmAiVoiceSessions/{recordId} { allow read, write: if false; }
    match /crmAiVoiceUtterances/{recordId} { allow read, write: if false; }
    match /crmAiDrafts/{recordId} { allow read, write: if false; }
    match /crmAiDraftRevisions/{recordId} { allow read, write: if false; }
    match /crmAiDraftRequests/{recordId} { allow read, write: if false; }
    match /crmProjectAiPreviews/{recordId} { allow read, write: if false; }
    match /crmProjectAiProposals/{recordId} { allow read, write: if false; }
    match /crmAiVoiceAttestations/{recordId} { allow read, write: if false; }

    // Data Input drafts and maintenance receipts are server-owned.
    match /crmDataInputDrafts/{document=**} { allow read, write: if false; }
    match /crmDataInputMaintenance/{document=**} { allow read, write: if false; }
    match /crmAiBudgetAccounts/{document=**} { allow read, write: if false; }
    match /crmAiBudgetLedgers/{document=**} { allow read, write: if false; }
    match /crmAiBudgetReservations/{document=**} { allow read, write: if false; }
    match /crmAiVoiceSessions/{document=**} { allow read, write: if false; }
    match /crmAiVoiceUtterances/{document=**} { allow read, write: if false; }
    match /crmAiVoiceAttestations/{document=**} { allow read, write: if false; }
    // Every named map field is accessed below; exact size also rejects unknown keys.
    // Demo D shared admin feedback. Ratings and learner namespaces are independent.
    match /entranceTestUiAnnotations/demo-d/items/{annotationId} {
      function text(v, low, high) { return v is string && v.size() >= low && v.size() <= high; }
      function number(v, low, high) { return v >= low && v <= high; }
      function actor(a) { return (a.size() == 3) && a.uid.matches('[\\s\\S]{1,128}') && a.raterId.matches('[\\s\\S]{1,60}') && a.name.matches('[\\s\\S]{2,80}'); }
      function uid(v) { return v.matches('[a-fA-F0-9]{8}(-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}'); }
      function context(c) {
        return (c.size() == 4) && c.componentState.matches('[\\s\\S]{0,160}')
          && ((c.view in ['intro','miccheck','review','done'] && c.page == c.view && c.questionId == null)
          || (c.view == 'question' && ((c.page == 'speaking' && c.questionId in ['speaking_q1','speaking_q2','speaking_q3'])
          || (c.page == 'vocab' && c.questionId in ['vocab_q1','vocab_q2','vocab_q3','vocab_q4'])
          || (c.page == 'grammar' && c.questionId in ['grammar_q1','grammar_q2','grammar_q3','grammar_q4'])
          || (c.page == 'listening' && c.questionId in ['listen_write_q1','listen_write_q2']))));
      }
      function fragment(f) {
        let r = f.rect;
        let t = f.text;
        return (f.size() == 4) && f.kind in ['element','text','layout'] && f.targetId.matches('[a-zA-Z0-9_/-]{1,200}')
          && (r.size() == 4) && r.x0 >= 0 && r.y0 >= 0 && r.x1 <= 1 && r.y1 <= 1 && r.x1 > r.x0 && r.y1 > r.y0
          && (f.kind == 'text' ? ((t.size() == 5) && t.runId == f.targetId && t.start is int && t.end is int && t.start >= 0 && t.end > t.start && t.end <= 20000 && t.fingerprint.matches('[\\s\\S]{1,32}') && t.quote.matches('[\\s\\S]{0,160}')) : t == null);
      }
      function anchor(a) {
        let f = a.fragments;
        return (a.size() == 4) && a.kind in ['content','layout'] && a.layoutSignature.matches('[\\s\\S]{1,240}') && a.label.matches('[\\s\\S]{1,160}') && f is map && f.size() >= 1 && f.keys().hasOnly(['f0','f1','f2'])
          && (('f0' in f) ? fragment(f.f0) : true) && (('f1' in f) ? fragment(f.f1) : true) && (('f2' in f) ? fragment(f.f2) : true);
      }
      function capture(c) {
        return (c.size() == 12)
          && number(c.frameWidth,1,20000) && number(c.frameHeight,1,20000) && number(c.scrollX,-100000,100000) && number(c.scrollY,-100000,100000) && number(c.visualOffsetX,-100000,100000) && number(c.visualOffsetY,-100000,100000) && number(c.visualScale,0.1,10) && c.locale in ['en','vi'] && number(c.textScale,50,300) && c.fontEn.matches('[\\s\\S]{0,100}') && c.fontVi.matches('[\\s\\S]{0,100}') && c.buildId.matches('[\\s\\S]{1,100}');
      }
      function payload(d) {
        return d.size() == 18 && uid(annotationId) && d.schemaVersion == 1 && d.anchorSchemaVersion == 1 && d.skin == 'd' && d.contentVersion == 'entrance_test_36plus_v1' && d.visualRevision == 'signal-noto-v2'
          && context(d.context) && anchor(d.anchor) && capture(d.capture) && text(d.body,1,2000) && d.body.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && uid(d.lastMutationId) && d.updatedAt == request.time;
      }
      function create(d) {
        return payload(d) && actor(d.author) && d.author.uid == request.auth.uid && d.lastEditor == d.author
          && d.createdAt == request.time && d.version == 1 && d.version is int && d.deleted == false && d.deletedAt == null && d.deletedBy == null;
      }
      function update(d, old) {
        return payload(d) && d.author == old.author && d.createdAt == old.createdAt
          && actor(d.lastEditor) && d.lastEditor.uid == request.auth.uid && d.version is int && d.version == old.version + 1 && d.lastMutationId != old.lastMutationId
          && d.deleted is bool && (d.deleted
            ? (old.deleted ? (d.deletedAt == old.deletedAt && d.deletedBy == old.deletedBy) : (d.deletedAt == request.time && d.deletedBy == d.lastEditor))
            : (d.deletedAt == null && d.deletedBy == null));
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && create(request.resource.data);
      allow update: if isAdmin() && update(request.resource.data, resource.data);
      allow delete: if false;
    }
  }
}
