{
    "name": "functions",
    "description": "Cloud Functions for secure server-side scoring",
    "scripts": {
        "lint": "eslint .",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "npm --prefix .. run build:read-aloud:connected-speech-index && firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "src/index.js",
    "dependencies": {
        "@google-cloud/documentai": "10.0.0",
        "@google-cloud/vertexai": "^1.12.0",
        "@google/genai": "^2.0.1",
        "@google/generative-ai": "^0.24.1",
        "axios": "^1.18.0",
        "busboy": "^1.6.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^7.5.0",
        "firebase-admin": "^12.7.0",
        "firebase-functions": "^7.3.2",
        "multer": "^2.0.0-rc.4",
        "unpdf": "^1.8.1"
    },
    "devDependencies": {
        "eslint": "^8.57.0"
    },
    "private": true
}
