    "audit:pronounce:1000": "python scripts/audit/pronunciation-reference-audit.py --base-url http://127.0.0.1:8081 --sample-size 1000 --seed 20260711 --output test-results/pronunciation-audit-1000.json",
    "backfill:pronunciation:reference-audio": "node scripts/audit/backfill_pronunciation_reference_audio.js",
    "campaign:pronounce:manifest": "python scripts/audit/pronunciation-reference-audit.py --create-manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --sample-size 3000 --seed 20260712",
    "campaign:pronounce:cohort1": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --cohort 1 --output test-results/pronunciation-audit-3000/cohort-1-rows.jsonl",
    "campaign:pronounce:cohort2": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --cohort 2 --output test-results/pronunciation-audit-3000/cohort-2-rows.jsonl",
    "campaign:pronounce:cohort3": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --cohort 3 --output test-results/pronunciation-audit-3000/cohort-3-rows.jsonl",
    "campaign:pronounce:report1000": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --aggregate-through 1 --output test-results/pronunciation-audit-3000/report-1000.json",
    "campaign:pronounce:report2000": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --aggregate-through 2 --output test-results/pronunciation-audit-3000/report-2000.json",
    "campaign:pronounce:report3000": "python scripts/audit/pronunciation-reference-audit.py --manifest test-results/pronunciation-audit-3000/manifest-3000-seed-20260712.json --aggregate-through 3 --output test-results/pronunciation-audit-3000/report-3000.json",
    "test:pronounce:browser": "node tests/browser/pronounce-harness-module-contract.test.js && node tests/browser/pronounce-mode-browser-check.js && node tests/browser/pronounce-version-comparison-browser-check.js && node tests/browser/pronounce-mode-syllable-playback-check.js && node tests/browser/pronounce-manual-review-browser-check.js",
    "verify:pronounce": "npm run test:pronounce:logic && npm run test:pronounce:browser",
    "test:crm:scheduler:browser": "node tests/browser/crm-scheduler-browser-check.js",
    "test:crm:entrance-test-result-pdf:browser": "node tests/browser/crm-entrance-test-result-pdf-browser-check.js",
    "test:reading-journey:quiz:browser": "node tests/browser/reading-journey-quiz-browser-check.js",
    "test:survival:browser": "node tests/browser/survival-mode-browser-check.js",
    "test:rfib:browser": "node tests/browser/rfib-mode-browser-check.js",
    "test:rmcsa:guardrails": "node tests/rmcsa-explanation-guardrails.test.js && python tests/rmcsa_enrichment_parser.test.py",
