    "test:rfib:lazy-loader-retry:browser": "node tests/browser/lazy-loader-retry-rfib-browser-check.js",
    "test:practice-router:back:browser": "node tests/browser/practice-router-back-popstate-browser-check.js",
    "test:read-aloud:v7:browser": "node tests/browser/read-aloud-question-picker-v7-dom-contract-browser-check.js",
    "test:read-aloud:lifecycle:browser": "node tests/browser/read-aloud-lifecycle-browser-check.js",
    "test:site-header:browser": "node tests/browser/site-header-about-check.js",
    "audit:srs:browser": "node scripts/audit/run-srs-browser-audit.js --base-url https://localhost:8443",
    "smoke:pronunciation-test": "node scripts/smoke-pronunciation-test-route.js --start-server --port 8791",
    "test:read-aloud:route": "node tests/read-aloud-route.test.js",
    "test:read-aloud:browser": "node tests/read-aloud-mode-regression.test.js",
    "test:read-aloud:connected-speech:service": "node tests/read-aloud-connected-speech-service.test.js",
    "test:read-aloud:speech-coach-audio": "node tests/speech-coach-kokoro-audio.test.js",
    "test:read-aloud:speech-coach-audio:browser": "node tests/browser/speech-coach-model-audio-browser-check.js",
    "generate:read-aloud:speech-coach-audio": "node scripts/kokoro/generate_speech_coach_audio.js",
    "generate:pronunciation:reference-audio": "node scripts/kokoro/generate_pronunciation_reference_audio.js",
    "verify:read-aloud:speech-coach-audio": "node scripts/kokoro/verify_speech_coach_audio.js",
    "test:difficulty": "node tests/difficulty-logic.test.mjs && node tests/performance-tracker.test.js && node tests/difficulty-manager-state.test.mjs && node tests/difficulty-manager-profiles.test.mjs && node tests/difficulty-filter-migration.test.mjs",
    "test:difficulty:browser": "node tests/browser/adaptive-difficulty-browser-check.js",
