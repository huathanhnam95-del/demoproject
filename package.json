{
  "name": "dictation-practice",
  "version": "1.8.2",
  "description": "Dictation practice app",
  "scripts": {
    "start": "node server.js",
    "emulators": "node scripts/emulators-start.js",
    "seed:admin-emulator": "node scripts/seed-emulator-admin.js",
    "dev": "start-emulators.bat",
    "setup": "node setup-https.js",
    "update-db": "node update-database.js",
    "sync-rules": "node sync-points-rules.js points-rules.csv",
    "build:read-aloud:connected-speech-index": "node scripts/read-aloud/build-connected-speech-index.js",
    "report:read-aloud:connected-speech-coverage": "node scripts/read-aloud/report-connected-speech-coverage.js",
    "version:sync": "node scripts/sync-version.js",
    "deploy": "npm run version:sync && npm run build:read-aloud:connected-speech-index && firebase deploy --only hosting",
    "lint": "eslint .",
    "lint:crm": "eslint \"public/crm-admin.js\" \"public/js/classroom-api.js\" \"public/js/crm/*.js\" \"functions/src/routes/admin/*.js\" \"functions/src/crm/*.js\" \"src/routes/admin.js\" --quiet",
    "verify:crm": "node scripts/crm/verify-crm-suite.js",
    "lint:entrance-crm": "eslint public/entrance-test.js public/crm-admin.js public/crm-entrance-test-result.js src/routes/entrance-tests.js src/routes/admin.js src/utils/firebase.js src/entrance-test/test36plus.js --quiet",
    "smoke:entrance-test": "node scripts/smoke-entrance-test.js --start-server --port 8787",
    "audit:a2-onboarding": "node scripts/audit/run-a2-onboarding-audit.js --base-url http://localhost:8443",
    "test:preloader:browser": "node tests/browser/preloader-browser-check.js",
    "test:preloader:browser:reduced": "node tests/browser/preloader-browser-check.js --reduced-motion",
    "test:preloader:browser:mobile": "node tests/browser/preloader-browser-check.js --mobile-low",
    "test:pronunciation-test:browser": "node tests/browser/pronunciation-test-browser-check.js",
    "test:pronounce:logic": "node --no-warnings tests/pronunciation-analyzer/analysis-pipeline.test.mjs && node --no-warnings tests/pronunciation-analyzer/syllable-detector.test.mjs && node --no-warnings tests/pronunciation-analyzer/stress-utils.test.mjs && node --no-warnings tests/pronunciation-analyzer/native-audio-player.test.mjs",
    "test:pronounce:browser": "node tests/browser/pronounce-mode-browser-check.js && node tests/browser/pronounce-mode-syllable-playback-check.js",
    "verify:pronounce": "npm run test:pronounce:logic && npm run test:pronounce:browser",
    "test:crm:scheduler:browser": "node tests/browser/crm-scheduler-browser-check.js",
    "test:crm:entrance-test-result-pdf:browser": "node tests/browser/crm-entrance-test-result-pdf-browser-check.js",
    "test:reading-journey:quiz:browser": "node tests/browser/reading-journey-quiz-browser-check.js",
    "test:rfib:browser": "node tests/browser/rfib-mode-browser-check.js",
    "test:rfib:lazy-loader-retry:browser": "node tests/browser/lazy-loader-retry-rfib-browser-check.js",
    "test:practice-router:back:browser": "node tests/browser/practice-router-back-popstate-browser-check.js",
    "test:read-aloud:v7:browser": "node tests/browser/read-aloud-question-picker-v7-dom-contract-browser-check.js",
    "test:site-header:browser": "node tests/browser/site-header-about-check.js",
    "audit:srs:browser": "node scripts/audit/run-srs-browser-audit.js --base-url https://localhost:8443",
    "smoke:pronunciation-test": "node scripts/smoke-pronunciation-test-route.js --start-server --port 8791",
    "test:read-aloud:route": "node tests/read-aloud-route.test.js",
    "test:read-aloud:browser": "node tests/read-aloud-mode-regression.test.js",
    "test:read-aloud:connected-speech:service": "node tests/read-aloud-connected-speech-service.test.js",
    "test:difficulty": "node tests/difficulty-logic.test.mjs && node tests/performance-tracker.test.js && node tests/difficulty-manager-state.test.mjs && node tests/difficulty-manager-profiles.test.mjs && node tests/difficulty-filter-migration.test.mjs",
    "test:difficulty:browser": "node tests/browser/adaptive-difficulty-browser-check.js",
    "verify:rfib": "node tests/rfib-content-core.test.js && node tests/browser/rfib-mode-browser-check.js && node tests/browser/practice-modes-browser-check.js",
    "test:connected-speech:backend": "python backend/test_connected_speech_worker.py",
    "eval:read-aloud:connected-speech": "node scripts/evals/read-aloud-connected-speech-metrics.js data/evals/read-aloud-connected-speech/template.csv",
    "report:read-aloud:connected-speech": "node scripts/evals/read-aloud-connected-speech-report.js",
    "eval:read-aloud:connected-speech:parity": "node scripts/evals/read-aloud-connected-speech-parity.js tests/fixtures/read-aloud-connected-speech/parity-cases.json"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.10",
    "axios": "^1.13.4",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "multer": "^2.1.1",
    "openai": "^6.16.0",
    "opossum": "^9.0.0",
    "pitchfinder": "^2.3.4",
    "retry-axios": "^4.0.1",
    "ts-fsrs": "5.2.3",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "http-server": "^14.1.1",
    "playwright": "^1.58.2"
  }
}
