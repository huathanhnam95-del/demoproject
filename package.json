{
  "name": "dictation-practice",
  "version": "1.8.75",
  "description": "Dictation practice app",
  "scripts": {
    "start": "node server.js",
    "emulators": "node scripts/emulators-start.js",
    "seed:admin-emulator": "node scripts/seed-emulator-admin.js",
