    "eval:read-aloud:connected-speech": "node scripts/evals/read-aloud-connected-speech-metrics.js data/evals/read-aloud-connected-speech/template.csv",
    "report:read-aloud:connected-speech": "node scripts/evals/read-aloud-connected-speech-report.js",
    "eval:read-aloud:connected-speech:parity": "node scripts/evals/read-aloud-connected-speech-parity.js tests/fixtures/read-aloud-connected-speech/parity-cases.json",
    "test:smw:data": "node tests/smw-data-guardrails.test.js && python tests/smw_explanation_sanitizer.test.py",
    "test:smw:browser": "node tests/browser/smw-mode-browser-check.js",
    "verify:smw": "npm run test:smw:data && npm run test:smw:browser",
    "test:sst:unit": "node tests/sst-form-scoring.test.js && node tests/sst-shell-wiring.test.js && node tests/sst-kokoro-guardrails.test.js",
    "test:sst:data": "node tests/sst-data-guardrails.test.js",
    "test:sst:browser": "node tests/browser/sst-mode-browser-check.js",
    "verify:sst": "npm run test:sst:unit && npm run test:sst:data && npm run test:sst:browser"
  },
