{
  "schemaVersion": 1,
  "description": "Authoritative release input policy defining file categories, protected builder metadata, and externalized media exclusion cohorts.",
  "categories": {
    "app-runtime": {
      "description": "Files required for application runtime on Firebase Hosting."
    },
    "build-only": {
      "description": "Files required during build and release preparation, omitted from production runtime if not in surface."
    },
    "external-media": {
      "description": "Practice media hosted on Google Cloud Storage and referenced via pinned catalogs."
    },
    "forbidden-private": {
      "description": "Sensitive credentials and environment files that must never enter a release candidate."
    },
    "backend-functions": {
      "description": "Cloud Functions backend application source code."
    },
    "non-runtime-docs": {
      "description": "Documentation, specifications, and presentation slide decks not required at build or runtime."
    },
    "non-runtime-tests": {
      "description": "Unit, integration, and browser test suites and fixtures not required in candidate."
    },
    "non-runtime-assets": {
      "description": "Raw uncompiled design assets and mockups outside the public runtime surface."
    },
    "non-runtime-scratch": {
      "description": "Scratch scripts, debug dumps, temporary outputs, and developer experiment files."
    },
    "non-runtime-tooling": {
      "description": "Development environment configurations, AI assistant metadata, and local development tools."
    }
  },
