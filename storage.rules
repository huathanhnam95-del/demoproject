rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isReasonableAudioUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType != null
        && (
          request.resource.contentType == 'audio/wav'
          || request.resource.contentType == 'audio/x-wav'
          || request.resource.contentType.matches('audio/.*wav.*')
        );
    }

    function isAllowedAttemptMediaUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType != null
        && (
          request.resource.contentType == 'audio/wav'
          || request.resource.contentType == 'audio/x-wav'
          || request.resource.contentType.matches('audio/.*wav.*')
          || request.resource.contentType == 'audio/webm'
          || request.resource.contentType == 'video/webm'
          || request.resource.contentType.matches('.*webm.*')
        );
    }

    function speakingAttemptDocPath(attemptId) {
      return /databases/(default)/documents/speakingAttempts/$(attemptId);
    }

    function speakingAttemptExists(attemptId) {
      return firestore.exists(speakingAttemptDocPath(attemptId));
    }

    function speakingAttemptData(attemptId) {
      return firestore.get(speakingAttemptDocPath(attemptId)).data;
    }

    function feedbackDocPath(attemptId, feedbackId) {
      return /databases/(default)/documents/speakingAttempts/$(attemptId)/feedback/$(feedbackId);
    }

    function feedbackExists(attemptId, feedbackId) {
      return firestore.exists(feedbackDocPath(attemptId, feedbackId));
    }

    function feedbackData(attemptId, feedbackId) {
      return firestore.get(feedbackDocPath(attemptId, feedbackId)).data;
    }

    match /uploads/{classId}/{workId}/{uid}/{allPaths=**} {
      // Students can read/write their own submissions if they are verified students
      allow read, write: if request.auth != null 
                         && request.auth.uid == uid 
                         && request.auth.token.isStudent == true;
      // Admins can read everything
      allow read: if isAdmin();
    }

    // Speaking attempt uploads (not gated by student status; retention is enforced server-side).
    match /practice-attempts/{uid}/{attemptId}/student.wav {
      // Strictly allow the expected filename; server signs reads via Admin SDK.
      allow write: if isOwner(uid)
        && isReasonableAudioUpload(30 * 1024 * 1024)
        && speakingAttemptExists(attemptId)
        && speakingAttemptData(attemptId).ownerUid == uid
        && speakingAttemptData(attemptId).status == 'awaiting_upload'
        && speakingAttemptData(attemptId).audio.studentPath == ('practice-attempts/' + uid + '/' + attemptId + '/student.wav');
      allow read: if false;
    }

    // Slot-based PTE attempt media uploads.
    match /practice-attempts/{uid}/{attemptId}/{slotFile} {
      allow write: if isOwner(uid)
        && slotFile != 'student.wav'
        && isAllowedAttemptMediaUpload(50 * 1024 * 1024)
        && speakingAttemptExists(attemptId)
        && speakingAttemptData(attemptId).ownerUid == uid
        && speakingAttemptData(attemptId).status == 'awaiting_upload'
        && speakingAttemptData(attemptId).mediaSlots[slotFile].status == 'awaiting_upload'
        && speakingAttemptData(attemptId).mediaSlots[slotFile].storagePath == ('practice-attempts/' + uid + '/' + attemptId + '/' + slotFile);
      allow read: if false;
    }

    // CRM book PDF uploads (admin-only, existence-gated).
    function isCrmAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function bookDocPath(bookId) {
      return /databases/(default)/documents/crmBooks/$(bookId);
    }

    match /crm-books/{bookId}/source.pdf {
      allow write: if isCrmAdmin()
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && firestore.exists(bookDocPath(bookId))
        && firestore.get(bookDocPath(bookId)).data.status == 'awaiting_upload';
      allow read: if false;
    }

    // CRM book background music MP3 uploads (admin-only, audio content-type).
    match /crm-books/{bookId}/bgm/{audioFile} {
      allow read: if isSignedIn();
      allow write: if isCrmAdmin()
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && (
          request.resource.contentType == 'audio/mpeg'
          || request.resource.contentType == 'audio/mp3'
          || request.resource.contentType == 'audio/wav'
          || request.resource.contentType == 'audio/x-wav'
          || request.resource.contentType.matches('audio/.*')
        );
      allow delete: if isCrmAdmin();
    }

    match /crm-books/{bookId}/{derived} {
      allow read, write: if false;
    }

    // Teacher/admin feedback audio uploads.
    match /practice-attempt-feedback/{attemptId}/{feedbackId}/{filename} {
      // API writes feedback audio paths as: practice-attempt-feedback/{attemptId}/{feedbackId}/{uid}.wav
      allow write: if isSignedIn()
        && filename == (request.auth.uid + '.wav')
        && isReasonableAudioUpload(30 * 1024 * 1024)
        && feedbackExists(attemptId, feedbackId)
        && feedbackData(attemptId, feedbackId).authorUid == request.auth.uid
        && feedbackData(attemptId, feedbackId).status == 'awaiting_upload'
        && feedbackData(attemptId, feedbackId).audioPath == ('practice-attempt-feedback/' + attemptId + '/' + feedbackId + '/' + request.auth.uid + '.wav');
      allow read: if false;
    }

    // Verified generated references are served through Functions after the
    // Firestore verification gate; clients never access Storage directly.
    match /pronunciation-reference-audio/{allPaths=**} {
      allow read, write: if false;
    }

    // CRM Teaching Session audio recordings (admin/teacher upload up to 250MB)
    match /teachingSessions/{studentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024;
      allow delete: if isSignedIn() && (isAdmin() || isCrmAdmin());
    }
  }
}
