rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{classId}/{workId}/{uid}/{allPaths=**} {
      // Students can read/write their own submissions
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admins can read everything
      // Note: Custom claims in storage rules don't always propagate instantly, but we can check if token.isAdmin == true
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
}
