rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{classId}/{workId}/{uid}/{allPaths=**} {
      // Students can read/write their own submissions if they are verified students
      allow read, write: if request.auth != null 
                         && request.auth.uid == uid 
                         && request.auth.token.isStudent == true;
      // Admins can read everything
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Speaking attempt uploads (not gated by student status; retention is enforced server-side).
    match /practice-attempts/{uid}/{attemptId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }

    // Teacher/admin feedback audio uploads.
    match /practice-attempt-feedback/{attemptId}/{feedbackId}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }
  }
}
