{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pronunciation-segmentation-manifest-v1",
  "title": "Pronunciation Segmentation Corpus Manifest",
  "description": "Schema for the evaluation corpus manifest used by phoneme-based syllable segmentation v3.",
  "type": "object",
  "required": ["version", "createdAt", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the manifest."
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of manifest creation.",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "description": "Array of corpus sample entries.",
      "items": {
        "type": "object",
        "required": [
          "sampleId",
          "targetWord",
          "referenceIpa",
          "expectedObservedCount",
          "category",
          "speakerCohort",
          "sourceHash",
          "labelProvenance"
        ],
        "additionalProperties": false,
        "properties": {
          "sampleId": {
            "type": "string",
            "pattern": "^[a-z0-9\\-]+$",
            "description": "Deidentified sample identifier. Must contain only lowercase alphanumerics and hyphens."
          },
          "targetWord": {
            "type": "string",
            "minLength": 1,
            "description": "The word the speaker was prompted to say."
          },
          "referenceIpa": {
            "type": "string",
            "description": "Canonical IPA transcription for the target word."
          },
          "expectedObservedCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Expected number of syllables observed in the recording."
          },
          "category": {
            "type": "string",
            "enum": ["clean", "omission", "insertion", "accented", "unrateable"],
            "description": "Classification of the sample."
          },
          "speakerCohort": {
            "type": "string",
            "description": "Speaker group descriptor. Must never be a name or account ID."
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of the source audio file."
          },
          "labelProvenance": {
            "type": "string",
            "enum": ["manual", "deterministic-transform", "automated"],
            "description": "How the ground-truth label was produced."
          },
          "verifiedSpans": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["start", "end"],
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "type": "number",
                      "description": "Start time in seconds."
                    },
                    "end": {
                      "type": "number",
                      "description": "End time in seconds."
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional array of verified time-span objects, or null."
          }
        }
      }
    }
  }
}
